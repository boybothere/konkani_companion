# Copy the variables you need into .env.local (never commit .env.local).

# --- Python backend (server-side only; never exposed to the browser) ---
# The URL printed by the Colab runner (or http://localhost:8000 when running locally)
BACKEND_URL=
# Must match BACKEND_API_KEY on the backend
BACKEND_API_KEY=

# --- Firebase web config (chat history) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
