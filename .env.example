# Copy the variables you need into .env.local (never commit .env.local).

# --- Python backend (server-side only; never exposed to the browser) ---
# The URL printed by the Colab runner (or http://localhost:8000 when running locally)
BACKEND_URL=
# Must match BACKEND_API_KEY on the backend
BACKEND_API_KEY=

# --- Sign-in (optional) ---
# Who may use the app. Empty = any Google account.
# Comma-separated emails and/or whole domains, e.g. "me@gmail.com,@college.edu"
AUTH_ALLOWED_EMAILS=

# --- Firebase web config (sign-in + chat history) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Abuse protection: per-user daily quotas (server-side, never NEXT_PUBLIC) ---
# Firebase service account so the server can count usage in Firestore
# (Firebase console > Project settings > Service accounts > Generate new private key).
# Paste the JSON on one line, or base64-encode it. Without it, quotas are counted
# in server memory only (resets on restart; weak on Vercel).
FIREBASE_SERVICE_ACCOUNT_KEY=
# Daily limits per user (0 = unlimited). Reset at midnight IST.
QUOTA_CHAT_PER_DAY=150
QUOTA_DOCUMENT_PER_DAY=20
QUOTA_VOICE_PER_DAY=60
QUOTA_TRANSLATE_PER_DAY=200
# The same question at most this many times within QUOTA_DUPLICATE_WINDOW_S seconds.
QUOTA_DUPLICATE_MAX=3
QUOTA_DUPLICATE_WINDOW_S=600
