# Copy the variables you need into .env.local (never commit .env.local).

# --- Python backend (server-side only; never exposed to the browser) ---
# The URL printed by the Colab runner (or http://localhost:8000 when running locally)
BACKEND_URL=
# Must match BACKEND_API_KEY on the backend
BACKEND_API_KEY=

# --- Sign-in (optional) ---
# Who may use the app. Empty = any Google account.
# Comma-separated emails and/or whole domains, e.g. "me@gmail.com,@college.edu"
AUTH_ALLOWED_EMAILS=

# --- Firebase web config (sign-in + chat history) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
