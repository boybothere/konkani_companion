# Copy to backend/.env (Docker) or add as Colab Secrets. Never commit real values.

# --- Required ---
GROQ_API_KEY=
# Shared secret between the Next.js server and this API. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKEND_API_KEY=

# --- Web search (first configured provider that returns results wins) ---
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
SEARCH_PROVIDERS=firecrawl,tavily,duckduckgo
# auto = skip search for greetings/small talk; always; never
SEARCH_MODE=auto
SEARCH_MAX_RESULTS=5
FIRECRAWL_SCRAPE=true

# --- Models ---
# gpu = Qwen + Whisper on the GPU; mock = no models (for UI development and tests)
MODEL_BACKEND=gpu
# groq or mock
LLM_BACKEND=groq
QWEN_MODEL=braisefernz07/konkani-qwen-lora
WHISPER_MODEL=medium
WHISPER_LANGUAGE=hi
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
GROQ_REASONING_EFFORT=low

# --- Translation ---
TRANSLATE_CHUNK_WORDS=250
TRANSLATE_MAX_NEW_TOKENS=1024

# --- Limits ---
RATE_LIMIT_PER_MINUTE=30
MAX_INPUT_CHARS=4000
MAX_AUDIO_SECONDS=120
MAX_DOCUMENT_PAGES=10
MAX_DOCUMENT_CHARS=6000

# --- OCR ---
OCR_LANGS=hin+mar+eng
OCR_FORCE=false

# --- Colab runner only ---
NGROK_AUTHTOKEN=
# Your reserved ngrok domain, e.g. something.ngrok-free.dev (optional)
NGROK_DOMAIN=
