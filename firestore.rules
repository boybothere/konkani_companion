rules_version = '2';

// Paste into Firebase console -> Firestore Database -> Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can read and write only their own chats.
    match /users/{userId}/chats/{chatId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['messages', 'preview', 'updatedAt', 'title'])
        && (!('title' in request.resource.data)
            || (request.resource.data.title is string && request.resource.data.title.size() <= 120))
        && request.resource.data.messages is list
        && request.resource.data.messages.size() <= 200
        && request.resource.data.preview is string
        && request.resource.data.preview.size() <= 200
        && request.resource.data.updatedAt is number;
    }

    // Each user's memory: short facts they let the app remember. Only the
    // owner can read, change or delete it.
    match /users/{userId}/profile/memory {
      allow read, delete: if request.auth != null && request.auth.uid == userId;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['facts', 'enabled', 'updatedAt'])
        && request.resource.data.facts is list
        && request.resource.data.facts.size() <= 12
        && request.resource.data.enabled is bool
        && request.resource.data.updatedAt is number;
    }

    // Daily usage counters (usage/{uid}/days/{day}) are written only by the
    // server with the Admin SDK, which bypasses these rules; browsers can't
    // read or change them, so the catch-all below keeps them closed.

    // Everything else (including the old shared "chats" and "sessions"
    // collections) is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
