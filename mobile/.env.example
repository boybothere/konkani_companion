# Copy to .env.local (never commit it). Expo reads EXPO_PUBLIC_* at build time;
# these values end up inside the app, so only put public configuration here:
# never API keys, BACKEND_API_KEY, or other secrets.

# Which build flavour to produce: development | staging | production
APP_VARIANT=development

# The deployed Next.js app whose /api routes the mobile app calls.
#   development: your PC on the same Wi-Fi, e.g. http://192.168.1.20:3000
#   production:  https://konkani-companion.vercel.app
EXPO_PUBLIC_API_BASE_URL=https://konkani-companion.vercel.app

# Firebase web config: the same public values as the website's NEXT_PUBLIC_FIREBASE_*.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In "Web client ID" (an OAuth client id, not a secret):
# Firebase console -> Authentication -> Sign-in method -> Google -> Web SDK configuration.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# iOS only, when GoogleService-Info.plist is not present: the REVERSED_CLIENT_ID
# value from that file, e.g. com.googleusercontent.apps.1234-abcd
GOOGLE_IOS_URL_SCHEME=
